<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace=
        "jp.levtech.rookie.attendance.mapper.AdminAttendanceMapper">


    <!--
        DBの検索結果とAdminAttendanceViewの項目を対応させる
    -->
    <resultMap id="adminAttendanceViewResultMap"
               type=
               "jp.levtech.rookie.attendance.dto.AdminAttendanceView">

        <!-- 勤務日 -->
        <result column="working_day"
                property="workingDay"/>

        <!-- 社員ID -->
        <result column="employee_id"
                property="employeeId"/>

        <!-- 社員名 -->
        <result column="employee_name"
                property="employeeName"/>

        <!-- 部署名 -->
        <result column="department_name"
                property="departmentName"/>

        <!-- 出勤予定時刻 -->
        <result column="working_start_time"
                property="workingStartTime"/>

        <!-- 退勤予定時刻 -->
        <result column="working_end_time"
                property="workingEndTime"/>

        <!-- 実際の出勤時刻 -->
        <result column="actual_working_start_time"
                property="actualWorkingStartTime"/>

        <!-- 実際の退勤時刻 -->
        <result column="actual_working_end_time"
                property="actualWorkingEndTime"/>

        <!-- 勤務区分 -->
        <result column="work_type"
                property="workType"/>

        <!-- 承認済み有給の有無 -->
        <result column="paid_leave"
                property="paidLeave"/>

    </resultMap>


    <!--
        対象月・部署・社員ID・社員名から
        管理者用の勤怠実績を検索する
    -->
    <select id="findByConditions"
            resultMap="adminAttendanceViewResultMap">

        SELECT
            attendance.working_day,

            employee.employee_id,

            employee.employee_name,

            CASE employee.department_id
                WHEN 1 THEN '営業部'
                WHEN 2 THEN '総務部'
                WHEN 3 THEN '人事部'
                ELSE ''
            END AS department_name,

            attendance.working_start_time,

            attendance.working_end_time,

            attendance.actual_working_start_time,

            attendance.actual_working_end_time,

            attendance.work_type,

            EXISTS (
                SELECT
                    1
                FROM
                    tb_trn_paid_holiday_request
                        paid_holiday
                WHERE
                    paid_holiday.employee_id =
                        employee.employee_id
                AND
                    paid_holiday.holiday =
                        attendance.working_day
                AND
                    paid_holiday.request_flag = 2
            ) AS paid_leave

        FROM
            tb_trn_attendance attendance

        INNER JOIN
            tb_mst_employee employee
        ON
            attendance.user_id =
                employee.employee_id

        WHERE
            attendance.working_day
                BETWEEN #{startDate}
                AND #{endDate}


        <!-- 部署が選択された場合だけ部署で絞り込む -->
        <if test="departmentId != null">

            AND
                employee.department_id =
                    #{departmentId}

        </if>


        <!-- 検索文字が入力された場合だけ検索する -->
        <if test="keyword != null and keyword != ''">

            AND
                (
                    employee.employee_id
                        ILIKE
                        CONCAT(
                            '%',
                            #{keyword},
                            '%'
                        )

                    OR

                    employee.employee_name
                        ILIKE
                        CONCAT(
                            '%',
                            #{keyword},
                            '%'
                        )
                )

        </if>


        ORDER BY
            attendance.working_day ASC,

            employee.employee_id ASC

    </select>

</mapper>